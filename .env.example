# 服务器配置：修改后运行 bash restart.sh 生效

# 监听地址：0.0.0.0 允许通过服务器 IP 访问
HOST=0.0.0.0

# 网站端口：8080 已被占用时可使用 8081，也可以改为其他空闲端口
PORT=8081

# 网站登录账号
ADMIN_USER=admin

# 网站登录密码：留空时，start.sh 首次启动会自动生成并写回此处
# 自行设置时至少 16 个字符；包含 # 等特殊字符时请用双引号包裹
ADMIN_PASSWORD=

# 账号、草稿、媒体和加密密钥的保存目录；相对路径以项目根目录为准
DATA_DIR=.data

# 使用 IP:端口访问时留空；配置 HTTPS 反向代理时填写，不要以 / 结尾
# 例如：https://square.example.com
PUBLIC_ORIGIN=
