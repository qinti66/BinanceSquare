{
  "name": "binancesquare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "start:api": "node server/index.mjs",
    "test:client": "node --test tests/client.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:browser:media": "node scripts/browser-qa.mjs --extended",
    "start": "node --env-file=.env server/production.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "test:browser:production": "node scripts/production-browser-qa.mjs",
    "test:browser:connection": "node scripts/account-connection-browser-qa.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "lightweight-charts": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
